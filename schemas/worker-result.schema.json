{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-result.schema.json",
  "title": "Veriloop developer or fixer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "status",
    "termination",
    "changed_files",
    "checks",
    "tool_failures",
    "artifacts",
    "blocker"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["developer", "fixer"]
    },
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "termination": {
      "type": "string",
      "enum": [
        "completed",
        "tool_error",
        "timeout",
        "cancelled",
        "context_limit",
        "invalid_result"
      ]
    },
    "changed_files": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "checks": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/check" }
    },
    "tool_failures": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/tool_failure" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "needs_user_input"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "dependency_unavailable",
            "permission_denied",
            "tool_error",
            "timeout",
            "cancelled",
            "context_limit",
            "invalid_result",
            "acceptance_failed",
            "other"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "needs_user_input": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "criterion",
        "check",
        "exit_code",
        "result",
        "evidence",
        "artifact_path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["command", "assertion"]
        },
        "criterion": { "type": "string", "minLength": 1, "maxLength": 200 },
        "check": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "exit_code": { "type": ["integer", "null"] },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "blocked"]
        },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 512 },
        "artifact_path": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "tool_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "operation", "error", "artifact_path"],
      "properties": {
        "tool": { "type": "string", "minLength": 1, "maxLength": 100 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 200 },
        "error": { "type": "string", "minLength": 1, "maxLength": 512 },
        "artifact_path": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    }
  }
}
